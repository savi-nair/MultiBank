# Runtime configuration for the mb.io e2e suite (read by src/config/env.ts).
# Copy to .env and adjust. Every value is optional; the defaults below are
# what the suite uses when a variable is unset.

# --- Targets -----------------------------------------------------------------
BASE_URL=https://mb.io
LEGACY_URL=https://trade.multibank.io
# Locale segment such as en-AE. Empty = let the site geo-redirect.
LOCALE=
CORE_API_URL=https://core-api.mb.io/api/io/v1
MARKET_DATA_API_URL=https://mbg-market-data-service.mb.io/api/io/v1

# --- Runner ------------------------------------------------------------------
# false = show the browser window. Defaults to false locally, true when CI=true.
HEADLESS=false
# CI=false
# Parallel workers. Unset = Playwright default locally, 2 on CI.
# WORKERS=1
# Retries per test. Unset = 0 locally, 2 on CI.
# RETRIES=0

# --- Timeouts (ms) -----------------------------------------------------------
TEST_TIMEOUT_MS=90000
NAVIGATION_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000
EXPECT_TIMEOUT_MS=15000
CONTENT_LOAD_TIMEOUT_MS=20000
API_LATENCY_BUDGET_MS=3000

# --- Link checker ------------------------------------------------------------
LINK_CHECK_CONCURRENCY=6
LINK_CHECK_TIMEOUT_MS=20000
